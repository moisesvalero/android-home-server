# ==============================================================================
# ANDROID HOME SERVER - VARIABLES DE ENTORNO (PLANTILLA)
# ==============================================================================
# Copia este archivo como ~/.hermes/.env en tu dispositivo Android o en local:
#   cp .env.example .env
# Rellena únicamente las claves de los servicios que desees utilizar.
# NUNCA compartas ni subas tu archivo .env con valores reales a Git.
# ==============================================================================

# --- Dispositivo y Servidor ---
SERVER_NAME="Android Home Server"
SERVER_PORT=8090
DLNA_PORT=8200

# --- Notificaciones y Control: Telegram Bot ---
TELEGRAM_BOT_TOKEN=""
TELEGRAM_ALLOWED_USERS=""
TELEGRAM_HOME_CHANNEL=""

# --- Proveedores LLM / Inteligencia Artificial (Elige tu preferido) ---
# Hermes y los scripts soportan cualquier proveedor compatible con la API de OpenAI
DEFAULT_LLM_PROVIDER="deepseek"
DEFAULT_LLM_MODEL="deepseek-flash"

# 1. DeepSeek (Económico, rápido y excelente en español)
DEEPSEEK_API_KEY=""
DEEPSEEK_BASE_URL="https://api.deepseek.com"

# 2. OpenAI (GPT-4o, GPT-4o-mini, etc.)
OPENAI_API_KEY=""
OPENAI_BASE_URL="https://api.openai.com/v1"

# 3. Anthropic (Claude 3.5 Sonnet / Haiku)
ANTHROPIC_API_KEY=""

# 4. OpenRouter (Acceso a cientos de modelos abiertos y comerciales)
OPENROUTER_API_KEY=""
OPENROUTER_BASE_URL="https://openrouter.ai/api/v1"

# 5. Groq (Llama 3 / Mistral con inferencia ultrarrápida)
GROQ_API_KEY=""
GROQ_BASE_URL="https://api.groq.com/openai/v1"

# 6. Google Gemini
GEMINI_API_KEY=""

# 7. Ollama / LLM Local (Si tienes una máquina en tu red local con GPU)
OLLAMA_BASE_URL="http://192.168.1.50:11434/v1"

# --- Motores de Búsqueda Web ---
# 1. Tavily Search (Soporta rotación de múltiples claves separadas por coma)
TAVILY_API_KEY=""
TAVILY_KEYS=""
TAVILY_BASE_URL="https://api.tavily.com"

# 2. Firecrawl (Extracción de páginas web en Markdown estructurado)
FIRECRAWL_API_KEY=""

# 3. Serper / Google Search (Opcional)
SERPER_API_KEY=""

# (DuckDuckGo está integrado como fallback automático nativo y gratuito sin necesidad de API key)

# --- Configuración del Radar de Empleo ---
# Personaliza las ciudades, regiones o palabras clave para el rastreo diario
JOB_SEARCH_LOCATIONS="Valencia, Alicante, Madrid"
JOB_SEARCH_KEYWORDS="web junior, frontend, soporte tecnico, helpdesk, administrativo"
JOB_REMOTE_ENABLED="true"

# --- Configuración del Radar de Chollos ---
DEALS_KEYWORDS="Xbox, PlayStation, Apple, MacBook, GPU, liquidacion, error de precio"

# --- Redes Sociales (Opcional: Difusión de noticias / contenido) ---
BSKY_HANDLE=""
BSKY_PASS=""
